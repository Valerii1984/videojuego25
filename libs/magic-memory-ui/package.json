{
  "name": "@game/magic-memory-ui",
  "version": "0.0.11",
  "private": false,
  "sideEffects": true,

  "main": "dist/index.js",
  "react-native": "dist/index.js",
  "types": "dist/index.d.ts",

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./assets/hero": {
      "types": "./dist/assets/hero/index.d.ts",
      "default": "./dist/assets/hero/index.js"
    },
    "./package.json": "./package.json"
  },

  "files": ["dist/**/*"],

  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.lib.json && node scripts/copy-assets.cjs",
    "prepublishOnly": "npm run build",
    "prepare": "echo skip"
  },

  "peerDependencies": {
    "expo": ">=52",
    "expo-av": ">=15.0.0",
    "expo-font": ">=12.0.0",
    "expo-image": ">=2 <3",
    "expo-linear-gradient": ">=12.7.0",
    "expo-localization": "~16.0.1",
    "expo-navigation-bar": ">=4.0.0",
    "expo-screen-orientation": ">=7.0.0",
    "react": ">=18",
    "react-native": ">=0.74",
    "react-native-gesture-handler": ">=2.16.0",
    "react-native-reanimated": ">=3.7.0",
    "react-native-svg": ">=15.0.0",
    "lottie-react-native": "7.1.0"
  },

  "devDependencies": {
    "typescript": "~5.3.3",
    "rimraf": "^5.0.0",
    "lottie-react-native": "7.1.0",
     "react-native": "0.74.5",
      "expo-localization": "~16.0.1"
  }
}
